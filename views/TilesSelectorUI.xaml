<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerShell Tile Selector"
        Height="950" Width="900" MinWidth="520" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <!-- Zone de redimensionnement : WindowChrome permet de tirer les bords même
         sans cadre natif. ResizeBorderThickness englobe la marge d'ombre (18px)
         + une petite zone de préhension, pour que le curseur de redimensionnement
         coïncide avec le bord VISIBLE de la fenêtre (et non le bord transparent). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="24" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ================= Brosses de thème (remplacées à l'exécution par ThemeManager) ================= -->
        <!-- Valeurs par défaut = thème sombre -->
        <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A2E" Offset="0"/>
            <GradientStop Color="#16213E" Offset="0.5"/>
            <GradientStop Color="#0F3460" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#DDE6F6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6ABEF5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#8CCEF8"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0F3460"/>
        <SolidColorBrush x:Key="GlassFillBrush" Color="#FFFFFF" Opacity="0.08"/>
        <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#FFFFFF" Opacity="0.20"/>
        <SolidColorBrush x:Key="GlassStrokeBrush" Color="#FFFFFF" Opacity="0.25"/>

        <!-- Boutons secondaires (verre) -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                                Padding="10,8" Background="{DynamicResource GlassFillBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassFillHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal (accent) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource AccentBrush}" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton rond (icône) : bascule de thème -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="18" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                                Background="{DynamicResource GlassFillBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassFillHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu contextuel (clic droit) des tuiles -->
        <ContextMenu x:Key="TileContextMenu">
            <MenuItem Name="EditMenuItem" Header="Modifier"/>
            <MenuItem Name="DeleteMenuItem" Header="Supprimer"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Conteneur racine : coins arrondis + fond dégradé (fenêtre sans cadre natif) -->
    <!-- La marge laisse respirer l'ombre portée tout autour de la fenêtre. -->
    <Border CornerRadius="16" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <!-- Main Content -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header applicatif (barre de titre personnalisée, déplaçable) -->
                <Grid Grid.Row="0" Name="TitleBar" Background="Transparent" Margin="0,0,0,24">
                    <TextBlock Text="Edge profil selector" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top"/>

                    <!-- Boutons applicatifs : thème / réduire / fermer -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Name="ThemeToggleButton" Width="40" Height="40" Margin="0,0,8,0"
                                ToolTip="Changer de thème (clair / sombre)"
                                Style="{StaticResource IconButton}" Content="&#x2600;"/>
                        <Button Name="MinimizeButton" Width="40" Height="40" Margin="0,0,8,0"
                                ToolTip="Réduire" FontSize="16"
                                Style="{StaticResource IconButton}" Content="&#x2013;"/>
                        <Button Name="CloseButton" Width="40" Height="40"
                                ToolTip="Fermer" FontSize="15"
                                Style="{StaticResource IconButton}" Content="&#x2715;"/>
                    </StackPanel>
                </Grid>

            <!-- Search Bar - Glass Effect -->
            <Border Grid.Row="0" Margin="0,64,0,24" Height="56" VerticalAlignment="Top">
                <Border CornerRadius="20" Padding="0" 
                        BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                        Background="{DynamicResource GlassFillBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="SearchBox" Grid.Column="0" Padding="20,16,20,16" VerticalContentAlignment="Center"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0" FontSize="16" SelectionBrush="{DynamicResource AccentBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="TextBoxBorder" Color="Transparent"/>
                                    </Style.Resources>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Name="PlaceholderText" Grid.Column="0" Text="Search tiles..." Padding="20,16,20,16" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16" Opacity="0.7"/>
                        <Button Name="ClearButton" Grid.Column="1" Width="40" Height="40" 
                                FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                                Style="{StaticResource GlassButton}"
                                Visibility="Hidden">X</Button>
                    </Grid>
                </Border>
            </Border>

            <!-- Tile Container -->
            <ListBox Name="TileList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu" Value="{StaticResource TileContextMenu}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- Outer Glass Container -->
                                    <Border Name="TileBorder" CornerRadius="24" 
                                            Margin="12" Width="180" Height="200" BorderThickness="1"
                                            BorderBrush="{DynamicResource GlassStrokeBrush}" Opacity="0.9"
                                            Background="{DynamicResource GlassFillBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="90" CenterY="100"/>
                                        </Border.RenderTransform>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="130"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image Section (color per tile) -->
                                            <Border Grid.Row="0" CornerRadius="24,24,0,0" Padding="16">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding Color1}" Offset="0"/>
                                                        <GradientStop Color="{Binding Color2}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding Image}" Width="80" Height="80" Opacity="0.95"/>
                                                </Viewbox>
                                            </Border>

                                            <!-- Title Section (subtle tint from tile color) -->
                                            <Border Grid.Row="1" CornerRadius="0,0,24,24" ClipToBounds="True">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color2}" Opacity="0.12"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"
                                                           Padding="12" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Animations & Triggers -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileBorder" Property="Opacity" Value="1"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <!-- Scale animation -->
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.08" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.08" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <!-- Opacity animation for glow effect -->
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="TileBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.9" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="TileBorder" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Scrollbar Style for transparency -->
                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Resources>
            </ListBox>

            <!-- Bottom action bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock Text="Ajouter profil" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <Button Name="AddTileButton" Width="36" Height="36"
                        Content="+" Style="{StaticResource AccentButton}"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
