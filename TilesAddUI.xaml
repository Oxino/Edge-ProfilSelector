<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une tuile" Height="320" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Titre:" Width="80" VerticalAlignment="Center"/>
            <TextBox Name="TitleBox" Width="300"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Image:" Width="80" VerticalAlignment="Center"/>
            <TextBox Name="ImageBox" Width="230"/>
            <Button Name="BrowseImageButton" Width="60" Margin="6,0,0,0">Parcourir</Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Profil:" Width="80" VerticalAlignment="Center"/>
            <TextBox Name="ProfilBox" Width="300"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Couleur:" Width="80" VerticalAlignment="Center"/>
            <TextBox Name="ColorBox" Width="200"/>
            <Button Name="PickColorButton" Width="80" Margin="6,0,0,0">Couleur...</Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="CancelAddButton" Width="80" Margin="0,0,6,0">Annuler</Button>
            <Button Name="SaveAddButton" Width="80">Ajouter</Button>
        </StackPanel>
    </Grid>
</Window>